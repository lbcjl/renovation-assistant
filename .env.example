# Environment variables for the renovation assistant (Next.js).
# Copy this file to `.env.local` and fill in real values (.env.local is gitignored).
# All values are optional: the defaults below match the built-in defaults, and
# provider settings saved from the settings page (data/provider_config.json)
# override these at runtime.

# --- LLM provider (OpenAI-compatible chat completions). Defaults target DeepSeek. ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Request timeout (seconds) applied to LLM chat calls.
REQUEST_TIMEOUT_SECONDS=60

# --- Embedding provider (OpenAI-compatible /embeddings). ---
# Defaults target SiliconFlow hosting BAAI/bge-m3 (strong Chinese retrieval).
# NOTE: DeepSeek has no embeddings endpoint, so this needs its own key.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# --- Image generation provider (OpenAI-compatible). ---
IMAGE_API_KEY=
IMAGE_BASE_URL=https://freeapi.dgbmc.top/v1
IMAGE_MODEL=gpt-image-2
# Optional HTTP(S) proxy used to reach the image provider, e.g. http://127.0.0.1:7897
IMAGE_PROXY_URL=

# --- Retrieval (RAG) ---
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.5

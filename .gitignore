# Knowledge base build artifacts and runtime data at the repo root: keep
# knowledge markdown sources tracked, ignore everything else (vector index,
# uploads, file metadata, raw source materials, and provider_config.json
# which contains API keys)
/data/*
!/data/knowledge/

# Database files (generated at runtime)
*.db

# TypeScript build info
*.tsbuildinfo

# Local code intelligence indexes
.codegraph/

# Trellis workspace (session notes, not code)
.trellis/workspace/

# Claude Code harness-installed global skills (plugin tooling, not part of this project)
.claude/skills/

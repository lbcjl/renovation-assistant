# LLM provider (OpenAI-compatible Chat Completions API).
# Defaults target DeepSeek; switch to another domestic model by changing
# LLM_BASE_URL / LLM_MODEL / LLM_API_KEY (e.g. Qwen via DashScope, GLM via Zhipu).
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Comma-separated list of allowed CORS origins (the frontend dev server).
CORS_ORIGINS=http://localhost:5173

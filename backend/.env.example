# LLM provider (OpenAI-compatible Chat Completions API).
# Defaults target DeepSeek; switch to another domestic model by changing
# LLM_BASE_URL / LLM_MODEL / LLM_API_KEY (e.g. Qwen via DashScope, GLM via Zhipu).
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Embedding provider for RAG (OpenAI-compatible /embeddings API).
# NOTE: DeepSeek has NO embeddings endpoint — use a dedicated provider.
# Default below targets SiliconFlow (BAAI/bge-m3). Alternatives:
#   Alibaba DashScope (text): base https://dashscope.aliyuncs.com/compatible-mode/v1 , model text-embedding-v4
EMBEDDING_API_KEY=sk-your-embedding-key-here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# Retrieval tuning (optional)
# RETRIEVAL_TOP_K=4
# RETRIEVAL_MIN_SCORE=0.5

# Comma-separated list of allowed CORS origins (the frontend dev server).
CORS_ORIGINS=http://localhost:5173

# JWT authentication (change JWT_SECRET_KEY in production!)
# Generate a secure key with: openssl rand -hex 32
JWT_SECRET_KEY=dev-secret-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# Database path (SQLite)
DATABASE_PATH=data/database.db
